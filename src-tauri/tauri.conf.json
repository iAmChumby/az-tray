{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AzTray",
  "version": "0.1.3",
  "identifier": "com.iamchumby.aztray",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "popover",
        "title": "AzTray",
        "width": 420,
        "height": 640,
        "minWidth": 380,
        "minHeight": 560,
        "maxWidth": 520,
        "maxHeight": 760,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "url": "index.html"
      },
      {
        "label": "main",
        "title": "AzTray Dashboard",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "resizable": true,
        "url": "index.html"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "AzTray"
      },
      "webviewInstallMode": { "type": "skip" }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
